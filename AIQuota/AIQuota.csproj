<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CI builds this on ubuntu-latest; without this the SDK refuses to cross-target
         net9.0-windows from a non-Windows OS (NETSDK1100). Publishing win-x64 still
         works fine cross-platform since it's pure IL + native host, no Windows APIs
         are actually invoked at build time. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AIQuota</AssemblyName>
    <RootNamespace>AIQuota</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>2.0.0</Version>
    <Product>AI Quota</Product>
    <AssemblyTitle>AI Quota</AssemblyTitle>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows toast notifications with action buttons (and their AUMID/COM activator
         registration for the unpackaged zip build); needs the windows10.0.17763.0 TFM,
         which matches the MSIX MinVersion. See Notifications/ToastNotifier.cs. -->
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>