<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CI builds this on ubuntu-latest; without this the SDK refuses to cross-target
         net9.0-windows from a non-Windows OS (NETSDK1100). Publishing win-x64 still
         works fine cross-platform since it's pure IL + native host, no Windows APIs
         are actually invoked at build time. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AIQuota</AssemblyName>
    <RootNamespace>AIQuota</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.9</Version>
    <Product>AI Quota</Product>
    <AssemblyTitle>AI Quota</AssemblyTitle>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Store edition: pass -p:StoreEdition=true when publishing for MSIX/Store submission.
       The Microsoft Store handles updates itself, so that build must not ship the GitHub
       self-updater - both because Store policy forbids apps updating themselves outside
       the Store, and because the packaged install location is read-only anyway. The
       GitHub-distributed zip builds (default, StoreEdition unset) keep the full feature. -->
  <PropertyGroup Condition="'$(StoreEdition)' == 'true'">
    <DefineConstants>$(DefineConstants);STORE_EDITION</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(StoreEdition)' == 'true'">
    <Compile Remove="SelfUpdater.cs" />
    <Compile Remove="NewVersionChecker.cs" />
    <Compile Remove="NewVersionPreference.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>