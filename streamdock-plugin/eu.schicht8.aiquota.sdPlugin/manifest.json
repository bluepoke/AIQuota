{
  "Name": "AIQuota",
  "Version": "1.2.0",
  "Author": "Peter Kossek",
  "Description": "Shows Claude Code session/weekly/credit usage from AIQuota and refreshes it on click.",
  "Icon": "static/icon.png",
  "CategoryIcon": "static/icon.png",
  "Category": "AIQuota",
  "CodePath": "plugin/index.html",
  "SDKVersion": 1,
  "URL": "https://github.com/bluepoke/AIQuota",
  "OS": [
    { "Platform": "windows", "MinimumVersion": "7" }
  ],
  "Actions": [
    {
      "UUID": "eu.schicht8.aiquota.usage",
      "Name": "AIQuota",
      "Tooltip": "Claude Code session/weekly/credit usage - press to refresh, hold to stop flashing",
      "Icon": "static/icon.png",
      "PropertyInspectorPath": "propertyInspector/usage/index.html",
      "state": 0,
      "States": [
        { "Image": "static/icon.png", "ShowTitle": false }
      ],
      "Settings": {},
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "VisibleInActionsList": true,
      "Controllers": ["Keypad"]
    }
  ]
}
